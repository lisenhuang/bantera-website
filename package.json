{
  "name": "website",
  "version": "0.19.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 2268",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test scripts/*.test.mjs",
